{
  "name": "@khimaros/pi-webui",
  "version": "0.5.1",
  "type": "module",
  "description": "a simple, standalone webui for pi.dev",
  "keywords": [
    "pi-package"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khimaros/pi-webui.git"
  },
  "homepage": "https://github.com/khimaros/pi-webui#readme",
  "bugs": {
    "url": "https://github.com/khimaros/pi-webui/issues"
  },
  "main": "dist/server/index.js",
  "bin": {
    "pi-webui": "dist/server/index.js"
  },
  "pi": {
    "extensions": [
      "dist/extension/index.js"
    ]
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build && node -e \"require('fs').chmodSync('dist/server/index.js', 0o755)\"",
    "prepack": "npm run build",
    "start": "node dist/server/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@trpc/server": "^11.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
